@prefix rml: <http://w3id.org/rml/>.
@prefix rr: <http://www.w3.org/ns/r2rml#>.
@prefix dbd: <https://example.org/db-delays/ontology/#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# state class

<#StateMapping>
    rml:logicalSource [ rml:source "db-delays.csv" ;
                       rml:referenceFormulation ql:CSV ] ;
    rr:subjectMap [
        rr:template "http://example.org/db-delays/resource/State/{state}" ;
        rr:class dbd:State ;
        rr:termType rr:IRI;
    ];
    rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [
        rml:reference "state" ;
        rr:datatype xsd:string
    ]
] .

# city class

<#CityMap>
rml:logicalsource [
    rml:source "DBtrainrides.csv" ;
    rml:referenceFormulation ql:CSV;
  ];

rr:subjectMap [
    rr:template "http://example.org/db-delays/ontology/#{@id}>;
    rr:class dbd:City;
]

rr:predicateObjectMap [
    rr:predicate rdfs:label;
    rr:objectMap [
        rr:reference "city"
    ]
];

# TODO: inState Property

# trainstop class

# atStation

# ontology: stopId, csv: ID
rr:predicateObjectMap [
    rr:predicateMap [rr:constant dbd:stopId;
        rr:termType rr:IRI];
    rr:objectMap [rml:reference "ID";
        rr:termType rr:Literal;
        rr:datatype xsd:string];

];

# ontology: lineLabel, csv: line
rr:predicateObjectMap [
    rr:predicateMap [rr:constant dbd:lineLabel;
        rr:termType rr:IRI];
    rr:objectMap [rml:reference "line";
        rr:termType rr:Literal;
        rr:datatype xsd:string];

];

# ontology: previousStations, csv: path
rr:predicateObjectMap [
    rr:predicateMap [rr:constant dbd:previousStations;
        rr:termType rr:IRI];
    rr:objectMap [rml:reference "path";
        rr:termType rr:Literal;
        rr:datatype xsd:string];
];

# ontology: plannedArrival, csv: arrival_plan
rr:predicateObjectMap [
